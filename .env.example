# ============================================================================
# Azure OpenAI Configuration
# ============================================================================

# Azure OpenAI API Key
# Obtenha em: https://portal.azure.com/
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Azure OpenAI Endpoint
# Exemplo: https://your-resource-name.openai.azure.com/
LLM_ENDPOINT=https://your-resource-name.openai.azure.com/

# Azure OpenAI API Version
# Recomendado: 2024-02-15 (versão mais recente)
LLM_API_VERSION=2024-02-15

# Nome do modelo deployado no Azure
# Exemplos: gpt-4, gpt-4-turbo, gpt-35-turbo
LLM_MODEL=gpt-4

# ============================================================================
# Model Configuration
# ============================================================================

# Temperatura do modelo (0.0 a 2.0)
# 0.0 = determinístico (recomendado para classificação)
# 1.0 = balanced
# 2.0 = muito criativo (não recomendado para este caso)
TEMPERATURE=0.3

# Número máximo de tentativas em caso de erro (retry automático)
MAX_RETRIES=3

# Tempo de espera entre tentativas em segundos (com backoff exponencial)
RETRY_DELAY_SECONDS=2

# Timeout para cada chamada ao LLM em segundos
TIMEOUT_SECONDS=30

# ============================================================================
# Application Configuration
# ============================================================================

# Versão do prompt (para rastreabilidade científica)
# Use semantic versioning (ex: 1.0, 1.1, 2.0)
PROMPT_VERSION=1.0

# Nível de logging
# Opções: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# Export Configuration
# ============================================================================

# Opções: "export total", "export com textDocument", "export limpo"
EXPORT_PROCESS="export limpo"
