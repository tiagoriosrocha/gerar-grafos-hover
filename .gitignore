# .gitignore para SLR LLM Reviewer

# Environment variables (sensitive)
.env
.env.local
.env.*.local
*.pem

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Output and logs
#output/*.csv
#output/*.json
#parquet/*.parquet

logs/*.log
logs/**/*.log
!output/.gitkeep
!parquet/.gitkeep
!logs/.gitkeep

# Temporary files
*.tmp
.cache
.tiktoken_cache/
cognee_workspace/
.cognee_system/
.data_storage/
.cognee_cache/
.pytest_cache/
.coverage

# OS
.DS_Store
Thumbs.db

# CSV files (opcional - comente para versionar)
# results/*.csv

vendor/